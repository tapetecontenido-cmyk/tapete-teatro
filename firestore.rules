rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()     { return request.auth != null; }
    function userId()     { return request.auth.uid; }
    function getRole()    { return get(/databases/$(database)/documents/users/$(userId())).data.role; }
    function isAdmin()    { return isAuth() && getRole() == 'admin'; }
    function isProfesor() { return isAuth() && (getRole() == 'profesor' || getRole() == 'admin'); }
    function isAlumno()   { return isAuth() && getRole() == 'alumno'; }
    function isOwner(uid) { return isAuth() && userId() == uid; }

    // ── USUARIOS ──────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin() || isProfesor();
      // Solo puede crearse a sí mismo, y siempre con role 'alumno' y activo true
      allow create: if isAuth() && isOwner(uid)
                    && request.resource.data.role == 'alumno'
                    && request.resource.data.activo == true;
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'activo']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── OBRAS Y FUNCIONES (solo información, sin compra) ───────
    match /obras/{obraId} {
      allow read: if true;
      allow write: if isAdmin();
      match /funciones/{funcionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ── PAPELERAS (solo admin) ────────────────────────────────
    match /papelera/{docId} {
      allow read, write: if isAdmin();
    }
    match /papeleraObras/{docId} {
      allow read, write: if isAdmin();
    }

    // ── TALLERES ──────────────────────────────────────────────
    match /talleres/{tallerId} {
      // El campo 'alumnosAprobados' (array de uids) vive en este
      // mismo documento y lo mantiene el admin/profesor al aprobar
      // o quitar el acceso de un alumno.
      // El campo 'profesoresIds' (array de uids) permite varios
      // profesores por taller.
      allow read: if true;
      // Solo admin puede crear o eliminar talleres
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Admin siempre puede editar; un profesor solo si está
      // asignado a este taller específico
      allow update: if isAdmin() ||
        (isProfesor() && userId() in resource.data.profesoresIds);

      // Camerino — solo admin/profesor asignado, o un alumno cuyo
      // uid esté en 'alumnosAprobados', y solo si el material está
      // desbloqueado.
      match /materiales/{materialId} {
        allow read: if isAdmin() || isProfesor() ||
          (isAuth() &&
           resource.data.desbloqueado == true &&
           userId() in get(/databases/$(database)/documents/talleres/$(tallerId)).data.alumnosAprobados);
        allow write: if isAdmin() ||
          (isProfesor() && userId() in get(/databases/$(database)/documents/talleres/$(tallerId)).data.profesoresIds);
      }
      match /fotos/{fotoId} {
        allow read: if isAuth();
        allow write: if isAdmin() ||
          (isProfesor() && userId() in get(/databases/$(database)/documents/talleres/$(tallerId)).data.profesoresIds);
      }
    }

    // ── INSCRIPCIONES ─────────────────────────────────────────
    match /inscripciones/{inscripcionId} {
      allow read:   if isAdmin() || isProfesor() || (isAuth() && resource.data.userId == userId());
      // Solo puede crear una inscripción a su propio nombre, y siempre en estado 'pendiente'
      allow create: if isAuth()
                    && request.resource.data.userId == userId()
                    && request.resource.data.estado == 'pendiente';
      // Solo admin/profesor pueden cambiar el estado (aprobar/rechazar)
      allow update: if isAdmin() || isProfesor();
      allow delete: if isAdmin();
    }

    // ── NOTICIAS ──────────────────────────────────────────────
    match /noticias/{noticiaId} {
      allow read:  if resource.data.publicado == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── NOTIFICACIONES ────────────────────────────────────────
    match /notificaciones/{notifId} {
      allow read:   if isAuth() && resource.data.userId == userId();
      // Un usuario puede crear notificaciones para sí mismo,
      // y admin/profesor pueden crear notificaciones para cualquier alumno
      allow create: if isAuth() && (request.resource.data.userId == userId() || isAdmin() || isProfesor());
      allow update: if isAuth() && resource.data.userId == userId();
      allow delete: if isAdmin();
    }

    // ── CONFIGURACIÓN ─────────────────────────────────────────
    match /configuracion/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── MENSAJES DE CONTACTO ──────────────────────────────────
    match /mensajes_contacto/{msgId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ── ANUNCIOS ──────────────────────────────────────────────
    match /anuncios/{anuncioId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || isProfesor();
    }
  }
}
